# ========== 服务 ==========
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# 首次初始化后请勿随意更改，否则已签发的登录令牌、密码哈希校验会失效
SECRET_KEY=please-change-me-to-a-random-string
PASSWORD_PEPPER=please-change-me-to-another-random-string

# 会话空闲过期时间（分钟）：无操作超过该时长需重新登录；活跃会话自动滑动续期
# 该值仅作为首次启动写入数据库的种子值，之后以管理后台「站点配置」中的修改为准
SESSION_IDLE_MINUTES=60

# ========== 内置管理员 ==========
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1q2w3e4r
ADMIN_PHONE=11111111111

# ========== 邮箱 SMTP（配置并开启后发送真实邮件，否则验证码打印在后端终端） ==========
# 本项目默认使用 163 邮箱：SMTP_HOST=smtp.163.com，密码填 163 的 POP3/SMTP 授权码
SMTP_ENABLED=false
SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=your_mailbox@163.com
SMTP_PASSWORD=your_163_smtp_authorization_code
SMTP_FROM=your_mailbox@163.com

# ========== 短信（默认 console 打印到后端终端；aliyun/tencent 为预留接入位） ==========
SMS_PROVIDER=console
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SIGN_NAME=SourceLink
SMS_TEMPLATE_CODE=
